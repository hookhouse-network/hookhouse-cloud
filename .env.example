# Copy this file to ".env" and paste your free keys after the = sign.
# .env stays on your PC only (it is never uploaded to GitHub).

# AI brain (free keys) — the system works with any one of them, best with all
GEMINI_API_KEY=        # https://aistudio.google.com  → Get API key
GROQ_API_KEY=          # https://console.groq.com     → API Keys
NVIDIA_API_KEY=        # https://build.nvidia.com     → Get API Key
OPENROUTER_API_KEY=    # https://openrouter.ai        → Keys

# Only for testing on this PC with Claude Code (1 = on)
USE_CLAUDE_CLI=0

# YouTube connection (Google Cloud > Credentials > OAuth client ID, type Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_UPLOAD_UNITS=100       # quota units per upload (Google reported ~100 since Dec 2025; was 1600)

# Added in Week 2–3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PEXELS_API_KEY=
CONTACT_URL=           # link that identifies this project to Wikimedia (e.g. your private GitHub repo page)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Affiliate links (optional; your own Amazon Associates accounts). Leave empty to keep links off.
AMAZON_COM_TAG=
AMAZON_IN_TAG=
# Meta app (developers.facebook.com > your app > Settings > Basic): turns short tokens into 60-day ones
META_APP_ID=
META_APP_SECRET=

# Meta Graph API version (v21.0 retires ~21 Jan 2027)
META_API_VERSION=v24.0
# Free API key (Google Cloud > Credentials > Create credentials > API key, restrict it to the YouTube Data API):
# the weekly 'what is winning in your niches' search. Without it the login of a connected channel is used.
YOUTUBE_API_KEY=
